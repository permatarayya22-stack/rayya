# Salin file ini menjadi .streamlit/secrets.toml untuk pengembangan lokal,
# atau isi nilainya di Streamlit Community Cloud > Settings > Secrets.
# Jangan pernah commit file secrets.toml yang berisi kredensial asli.

# Connection string Supabase (Session Pooler, IPv4):
# Dashboard Supabase > Connect > Session pooler.
# Password harus di-URL-encode (mis. @ menjadi %40).
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Untuk preview lokal tanpa Supabase, gunakan SQLite (akun tidak persisten di cloud):
# DATABASE_URL = "sqlite:///kospace_auth.db"

# Hanya dipakai sekali saat tabel users masih kosong: akun admin pertama dibuat otomatis.
ADMIN_USERNAME = "pemilik"
ADMIN_PASSWORD = "ganti-dengan-password-minimal-12-karakter"

# Kode undangan untuk pendaftaran mandiri di halaman Daftar.
# Kosongkan / hapus baris ini untuk menonaktifkan pendaftaran.
SIGNUP_CODE = "ganti-dengan-kode-undangan-rahasia"
